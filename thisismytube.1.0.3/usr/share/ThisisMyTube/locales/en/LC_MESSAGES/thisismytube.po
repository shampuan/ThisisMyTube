# --- Bildirimler & Uyarılar ---
msgid "Dil Değiştirildi"
msgstr "Language Changed"

msgid "Dil ayarının geçerli olabilmesi için lütfen uygulamayı kapatıp yeniden başlatın."
msgstr "Please restart the application for the language setting to take effect."

msgid "Video Bulunamadı"
msgstr "Video Not Found"

msgid "Oynatmayı denediğiniz videoya erişilemiyor. Adı değiştirilmiş, taşınmış ya da silinmiş olabilir. Yeni bir indeks taraması yapmanız önerilir. Bu taramadan sonra tüm dosyalara sorunsuzca erişebilirsiniz."
msgstr "The video you are trying to play cannot be accessed. It may have been renamed, moved, or deleted. Performing a new index scan is recommended."

msgid "Bilgi"
msgstr "Information"

msgid "Şu anda oynatılan bir video yok."
msgstr "No video is currently playing."

msgid "Güvenlik Uyarısı"
msgstr "Security Warning"

msgid "Private Mod için henüz parola belirlenmemiş!\nLütfen önce 'İndeksleme' menüsünden parola belirleyin."
msgstr "Password has not been set for Private Mode yet!\nPlease set a password from the 'Indexing' menu first."

# --- Hakkında Sayfası ---
msgid "ThisIsMyTube Hakkında"
msgstr "About ThisIsMyTube"

msgid "Sürüm:"
msgstr "Version:"

msgid "Lisans:"
msgstr "License:"

msgid "GUI / UX:"
msgstr "GUI / UX:"

msgid "Programlama Dili:"
msgstr "Programming Language:"

msgid "Yapımcı:"
msgstr "Author:"

msgid "Bu program; bilgisayarınızda depolanan video, film, dizi ve müzik gibi tüm yerel medya arşivinizi modern bir video platformu deneyimiyle önünüze seren gelişmiş bir kişisel medya merkezidir. Popüler video servislerinin sunduğu gezinme konforu, öneri akışı ve izleme kolaylıklarını tamamen çevrimdışı, gizlilik odaklı ve hızlı bir ortamda sunarak eğlenceli bir izleme deneyimi sağlar."
msgstr "This program is an advanced personal media center that brings your entire local media archive—videos, movies, series, and music—to life with a modern video platform experience. It provides an enjoyable viewing experience completely offline, privacy-focused, and fast."

msgid "Bu program hiçbir garanti getirmez."
msgstr "This program comes with absolutely no warranty."

msgid "Telif hakkı {copy} 2026 - A. Serhat KILIÇOĞLU"
msgstr "Copyright {copy} 2026 - A. Serhat KILIÇOĞLU"

# --- Ayarlar Sayfası ---
msgid "Uygulama Ayarları"
msgstr "Application Settings"

msgid "Uygulama Dili"
msgstr "Application Language"

msgid "Arayüzün görüntüleneceği dili seçin. (Değişikliğin geçerli olması için yeniden başlatma gerekir)"
msgstr "Select interface language. (Restart required for changes to take effect)"

msgid "Ayarları ve İndeksi Yedekle"
msgstr "Backup Settings & Index"

msgid "Taranan klasörleri, video listesini, yıldız puanlarını ve notlarınızı tek bir dosyaya kaydeder."
msgstr "Saves scanned folders, video list, star ratings, and personal notes into a single file."

msgid "Yedek Al..."
msgstr "Backup..."

msgid "Yedekten Geri Yükle"
msgstr "Restore from Backup"

msgid "Daha önce alınmış bir yedek dosyasını geri yükleyerek arşivinizi ve ayarlarınızı tazeler."
msgstr "Restores your archive and settings from a previously saved backup file."

msgid "Geri Yükle..."
msgstr "Restore..."

msgid "Küçük Resim (Thumbnail) Önbelleğini Temizle"
msgstr "Clear Thumbnail Cache"

msgid "Otomatik oluşturulan tüm video kapak resimlerini silerek diskte yer açar. Gerektiğinde tekrar üretilirler."
msgstr "Frees up disk space by deleting all generated cover thumbnails. They will be regenerated when needed."

msgid "Önbelleği Boşalt"
msgstr "Clear Cache"

msgid "Fabrika Ayarlarına Sıfırla"
msgstr "Reset to Factory Defaults"

msgid "Tüm taranmış videoları, puanları, kişisel notları ve dizin tanımlarını tamamen siler."
msgstr "Completely deletes all indexed videos, ratings, notes, and directory settings."

msgid "Her Şeyi Sıfırla"
msgstr "Reset Everything"

msgid "Yedek Dosyası Kaydet"
msgstr "Save Backup File"

msgid "JSON Dosyaları (*.json)"
msgstr "JSON Files (*.json)"

msgid "Yedek Dosyası Seçin"
msgstr "Select Backup File"

msgid "Geri Yükleme Onayı"
msgstr "Restore Confirmation"

msgid "Mevcut ayarlarınız ve video indeksiniz bu yedekle değiştirilecek. Onaylıyor musunuz?"
msgstr "Your current settings and video index will be replaced with this backup. Do you confirm?"

msgid "Önbellek Temizleme"
msgstr "Clear Cache"

msgid "Oluşturulmuş tüm video küçük resimleri silinecektir. Onaylıyor musunuz?"
msgstr "All generated video thumbnails will be deleted. Do you confirm?"

msgid "Dikkat: Sıfırlama"
msgstr "Warning: Reset"

msgid "Tüm kayıtlı videolar, notlar, puanlamalar ve dizinler kalıcı olarak silinecek!\n\nBu işlem geri alınamaz. Devam edilsin mi?"
msgstr "All saved videos, notes, ratings, and directories will be permanently deleted!\n\nThis cannot be undone. Do you want to continue?"

