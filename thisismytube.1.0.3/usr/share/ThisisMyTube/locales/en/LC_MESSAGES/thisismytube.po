msgstr "Videos Found: {count}"

msgid "Tarama Başarılı"
msgstr "Scan Successful"

msgid "Toplam {count} video bulundu ve Ana Sayfaya rastgele dizildi!"
msgstr "Total {count} videos found and randomly placed on Home page!"

msgid "Seçilen mod: {mode} ({count} video)"
msgstr "Selected mode: {mode} ({count} videos)"
