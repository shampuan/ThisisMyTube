msgid "Girdiğiniz yeni parolalar birbiriyle eşleşmiyor!"
msgstr "The new passwords do not match!"

msgid "Başarılı"
msgstr "Success"

msgid "Private mod parolası başarıyla kaydedildi."
msgstr "Private mode password saved successfully."

msgid "Parolayı kaldırmak için mevcut parolayı doğru girmelisiniz."
msgstr "You must enter the current password correctly to remove it."

msgid "Onay"
msgstr "Confirmation"

msgid "Private mod parolasını tamamen kaldırmak istediğinize emin misiniz?"
msgstr "Are you sure you want to completely remove the Private mode password?"

msgid "Parola koruması kaldırıldı."
msgstr "Password protection removed."

msgid "Kayıtlı indeks yüklendi: Toplam {count} video."
msgstr "Saved index loaded: Total {count} videos."

msgid "Tarama Tamamlandı!"
msgstr "Scan Completed!"

msgid "Toplam Dosya Sayısı: {count}"
msgstr "Total File Count: {count}"

